# === Sports Intelligence Platform — Environment Template ===
# Copy to .env and fill in all values. Never commit .env to git.

# ── Required ────────────────────────────────────────────────
OPENAI_API_KEY=
ODDS_API_KEY=
DISCORD_WEBHOOK_URL=

# ── Database (leave as-is for SQLite) ──────────────────────
USE_SQLITE=true
ENVIRONMENT=development

# ── Redis (uses db 3-5 to avoid conflict with trading bot) ─
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER=redis://localhost:6379/4
CELERY_BACKEND=redis://localhost:6379/5

# ── Optional ────────────────────────────────────────────────
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# ── Tuning (defaults are fine) ──────────────────────────────
PAPER_TRADING=true
DEFAULT_BANKROLL=1000.0
UNIT_SIZE_PCT=0.01
OPENAI_MODEL=gpt-4o
