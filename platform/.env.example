# ─────────────────────────────────────────────────────────────────────────────
# Sports Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required API Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here...
ODDS_API_KEY=...your-odds-api-key...

# ── Discord (at least one required for alerts) ────────────────────────────────
# Option A: Webhook only (simpler — just posts messages, no slash commands)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...your-webhook...

# Option B: Full bot (enables slash commands like /picks /clv /health)
DISCORD_BOT_TOKEN=...your-bot-token...
DISCORD_GUILD_ID=...your-server-id...

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=sip
POSTGRES_PASSWORD=...choose-a-strong-password...
POSTGRES_DB=sip_db

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
USE_SQLITE=false

# ── REST API Security ─────────────────────────────────────────────────────────
# All non-health endpoints require this key in the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_API_KEY=...generate-a-random-64-char-hex-string...

# ── CORS (comma-separated allowed origins for the REST API) ───────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Trading Mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true       # set to false only when you're ready for real bets
DEFAULT_BANKROLL=1000.0
UNIT_SIZE_PCT=0.01       # 1 unit = 1% of bankroll

# ── Risk Limits ───────────────────────────────────────────────────────────────
MAX_DAILY_UNITS=15.0
MAX_SINGLE_UNITS=5.0
MIN_EV_PCT=0.03          # minimum 3% EV to even consider a pick

# ── Optional Premium Data Sources ────────────────────────────────────────────
# Each is optional — the platform degrades gracefully if keys are not set.
# More keys = richer context = better picks.

# API-Sports (https://api-sports.io/) — injuries, standings, h2h, odds
API_SPORTS_KEY=

# TheSportsDB (https://www.thesportsdb.com/) — requires a paid key
# Sign up at thesportsdb.com/plans for a key
SPORTSDB_API_KEY=

# Stats Perform / Opta (https://www.statsperform.com/) — enterprise advanced stats
# xG, PPDA, progressive passes, live win probability — contact them for a key
STATSPERFORM_API_KEY=

# SportsData.io (https://sportsdata.io/) — per-sport subscription keys
# NFL, NBA, MLB, NHL, Soccer each have separate keys
SPORTSDATAIO_NFL_KEY=
SPORTSDATAIO_NBA_KEY=
SPORTSDATAIO_MLB_KEY=
SPORTSDATAIO_NHL_KEY=
SPORTSDATAIO_SOCCER_KEY=

# ── Redis (auto-configured via docker-compose — change only if using external Redis) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER=redis://redis:6379/1
CELERY_BACKEND=redis://redis:6379/2
