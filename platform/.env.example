# ─────────────────────────────────────────────────────────────────────────────
# Sports Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...
ODDS_API_KEY=...your-odds-api-key...

# ── Discord (at least one required for alerts) ────────────────────────────────
# Option A: Webhook only (simpler — just posts messages, no slash commands)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...your-webhook...

# Option B: Full bot (enables slash commands like /picks /clv /health)
DISCORD_BOT_TOKEN=...your-bot-token...
DISCORD_GUILD_ID=...your-server-id...

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=sip
POSTGRES_PASSWORD=...choose-a-strong-password...
POSTGRES_DB=sip_db

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
USE_SQLITE=false

# ── REST API Security ─────────────────────────────────────────────────────────
# All non-health endpoints require this key in the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_API_KEY=...generate-a-random-64-char-hex-string...

# ── CORS (comma-separated allowed origins for the REST API) ───────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Trading Mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true       # set to false only when you're ready for real bets
DEFAULT_BANKROLL=1000.0
UNIT_SIZE_PCT=0.01       # 1 unit = 1% of bankroll

# ── Risk Limits ───────────────────────────────────────────────────────────────
MAX_DAILY_UNITS=15.0
MAX_SINGLE_UNITS=5.0
MIN_EV_PCT=0.03          # minimum 3% EV to even consider a pick

# ── SportsData.io (https://sportsdata.io/) ────────────────────────────────────
# One key works for all sports — sport name is part of the URL, not the key.
# Endpoint format: https://api.sportsdata.io/v3/{sport}/scores/json/{endpoint}?key={key}
# Get your key at: https://sportsdata.io/cart/free-trial
SPORTSDATAIO_KEY=

# ── Betting Exchange & Parlay Apps ────────────────────────────────────────────
# PrizePicks — player props (public API, no key needed)
# https://www.prizepicks.com/

# Underdog Fantasy — player props (public API, no key needed)
# https://underdogfantasy.com/

# HardRock Bet — ML/spread/totals (covered by ODDS_API_KEY above — no extra key needed)
# https://www.hardrock.bet/

# Kalshi — prediction/event markets (full public API)
# Create keys at: https://kalshi.com/ → Account & Security → API Keys
# KALSHI_PRIVATE_KEY can be an inline PEM string or a path to a .pem file
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# ── Redis (auto-configured via docker-compose — change only if using external Redis) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER=redis://redis:6379/1
CELERY_BACKEND=redis://redis:6379/2
