[Unit]
Description=Sports Bot — Task Runner
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sports-bot
EnvironmentFile=/root/sports-bot/.env
ExecStart=/usr/bin/python3 /root/sports-bot/runner.py

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sports-bot

[Install]
WantedBy=multi-user.target
