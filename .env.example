# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ODDS_API_KEY=your_odds_api_key_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Trading ───────────────────────────────────────────────────────────────────
PAPER_TRADING=true           # Set to false only when ready for real money
BANKROLL=1000.00             # Starting bankroll in USD
MAX_KELLY_FRACTION=0.25      # Use 25% of full Kelly (reduce variance)
MAX_BET_PCT=0.05             # Never bet more than 5% of bankroll
MIN_EDGE_THRESHOLD=0.03      # Minimum 3% edge to place a bet
MIN_CONFIDENCE=0.60          # Minimum 60% AI confidence to place a bet

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=300    # How often to scan for opportunities (seconds)

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/betting_bot.db

# ── Proxy (Decodo residential) ────────────────────────────────────────────────
# DECODO_PROXY_URL=http://user:pass@gate.decodo.com   # base URL, port appended per-request
# SOFASCORE_USE_PROXY=1                              # 1=use proxy (default), 0=direct
# SOFASCORE_PROXY_URL=http://scraperapi:KEY@proxy-server.scraperapi.com:8001  # any proxy provider
# SOFASCORE_PROXY_PORT=7777                          # Decodo rotating port (used if no SOFASCORE_PROXY_URL)
# SOFASCORE_SESSION=TS_session=1; sofascore_gdpr_consent=1   # override cookie if blocked
